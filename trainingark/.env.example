# Copy to .env and fill in. Never commit .env itself.

# Supabase Postgres — transaction pooler (app queries)
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true"
# Supabase Postgres — session pooler (Prisma migrations / db push)
DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# NextAuth / Auth.js v5 session signing secret.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional. Auth.js infers the URL on Vercel; set this only for a custom
# domain or non-Vercel host, e.g. https://trainingark.com
# AUTH_URL=""
